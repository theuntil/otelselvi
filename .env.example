# =====================================================================
#  OTEL SELVİ — ORTAM DEĞİŞKENLERİ
#  Dokploy'da: Proje > Compose > Environment sekmesine bu satırları
#  kendi bilgilerinizle yapıştırın. Yerelde: bu dosyayı .env adıyla kopyalayın.
# =====================================================================

# Sitenin yayındaki adresi (sonunda / olmadan). Canonical, sitemap ve Google verileri bunu kullanır.
SITE_URL=https://otelselvi.com

# www.otelselvi.com gibi farklı bir alan adından gelenleri SITE_URL'ye 301 ile yönlendirir.
# Dokploy'a iki alan adını da ekleyip, her şey çalıştıktan sonra true yapın.
CANONICAL_REDIRECT=false

# Dokploy (Traefik) arkasında 1 kalmalı. Cloudflare turuncu bulut (proxy) açıksa 2 yapın.
TRUST_PROXY=1

# ---------- SMTP (form e-postaları) ----------
# Örnekler:
#   Yandex:       SMTP_HOST=smtp.yandex.com.tr  SMTP_PORT=465  SMTP_SECURE=true
#   Gmail/Workspace: SMTP_HOST=smtp.gmail.com  SMTP_PORT=465  SMTP_SECURE=true  (uygulama şifresi gerekir)
#   Outlook/M365: SMTP_HOST=smtp.office365.com SMTP_PORT=587  SMTP_SECURE=false
#   cPanel/Plesk hosting: SMTP_HOST=mail.otelselvi.com SMTP_PORT=465 SMTP_SECURE=true
SMTP_HOST=mail.otelselvi.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=iletisim@otelselvi.com
SMTP_PASS=buraya-mail-sifresi
# Sunucunuzun SSL sertifikası kendinden imzalıysa false yapın (önerilmez)
SMTP_TLS_REJECT_UNAUTHORIZED=true

# Gönderen adres (çoğu sunucu SMTP_USER ile aynı olmasını ister)
MAIL_FROM=iletisim@otelselvi.com
MAIL_FROM_NAME=Otel Selvi Web Sitesi
# Form mesajlarının gideceği adres
MAIL_TO=iletisim@otelselvi.com
# Kurumsal teklifler ayrı bir adrese gitsin isterseniz (boşsa MAIL_TO kullanılır)
MAIL_TO_CORPORATE=

# true yaparsanız e-posta gönderilmez, sadece loglara yazılır (test için)
MAIL_DRY_RUN=false

# ---------- Form güvenliği ----------
# En az 32 karakter rastgele bir değer. Üretmek için: openssl rand -hex 32
# Boş bırakırsanız ilk açılışta otomatik üretilip volume'a kaydedilir.
FORM_SECRET=
# Bir IP'nin 24 saatte gönderebileceği en fazla form sayısı (iki form ortak)
FORM_DAILY_LIMIT_PER_IP=4
# Tüm site için 24 saatlik üst sınır (bot saldırısında mail kutunuzu korur)
FORM_DAILY_LIMIT_GLOBAL=200
# Kısa süreli deneme sınırı: FORM_BURST_WINDOW_MINUTES dakikada en fazla FORM_BURST_LIMIT istek
FORM_BURST_LIMIT=10
FORM_BURST_WINDOW_MINUTES=15
# Formun en az kaç saniyede doldurulması gerektiği (daha hızlısı bot kabul edilir)
FORM_MIN_FILL_SECONDS=3
# Açık kalan bir formun kaç saat geçerli olduğu
FORM_MAX_AGE_HOURS=6

# ---------- Google Haritalar (isteğe bağlı) ----------
# Boş bırakırsanız ücretsiz gömülü harita + Google Haritalar'da açılan yol tarifi çalışır.
# Doldurursanız "Otelden ne kadar sürer?" bölümü süreyi/mesafeyi sayfada hesaplar.
# Google Cloud'da açılması gereken API'ler: "Maps JavaScript API" ve "Routes API".
# Anahtarı mutlaka HTTP referrer ile kısıtlayın: https://otelselvi.com/*  ve  https://www.otelselvi.com/*
GOOGLE_MAPS_API_KEY=
# Google Cloud > Harita Yönetimi'nden oluşturduğunuz Map ID (boşsa test kimliği DEMO_MAP_ID kullanılır)
GOOGLE_MAPS_MAP_ID=

# ---------- Arama motoru doğrulama (isteğe bağlı) ----------
# Google Search Console > HTML etiketi yöntemi > content="..." içindeki değer
GOOGLE_SITE_VERIFICATION=
# Bing Webmaster Tools (ChatGPT araması Bing dizinini de kullanır)
BING_SITE_VERIFICATION=
YANDEX_VERIFICATION=
